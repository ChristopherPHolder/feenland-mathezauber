  "narrative": {
    "northStar": "The Enchanted Garden",
    "overview": "The Enchanted Garden is a soft, playable fairy-tale world for seven-year-olds. Rounded lettering, a painted unicorn, scalloped fabric, berry counters, and a mint sticker album make arithmetic feel like helping a friend.\n\nKeep controls visually clear within the illustrated world. Plum text anchors pale lavender surfaces; raspberry marks the main action. Small lifts and short celebrations acknowledge choices and success without introducing urgency.",
    "keyCharacteristics": [
      "Lavender surroundings with plum reading contrast.",
      "Rounded Fredoka lettering and generous number choices.",
      "Painted character art paired with crisp SVG counting tokens.",
      "Gentle, optional motion and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Clear Action Rule",
        "body": "Reserve the solid raspberry treatment for the next action in the play sequence.",
        "section": "colors"
      },
      {
        "name": "The Gentle Motion Rule",
        "body": "Use short response motion for choices and rewards, and remove animations and transitions when reduced motion is requested.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use plum text on pale garden surfaces and white text on the raspberry primary action.",
      "Do pair decorative artwork with clear labels and meaningful accessible names.",
      "Do keep answer states visible through shape, border, and text as well as color.",
      "Do honor reduced motion and preserve visible keyboard focus."
    ],
    "donts": [
      "Don’t replace the local Fredoka face with a system display font.",
      "Don’t use decorative glyph characters in place of the existing SVG motif vocabulary.",
      "Don’t introduce timers or punitive visual feedback into the garden."
    ]
  }
}
